# macOS
.DS_Store
.AppleDouble
.LSOverride

# Directory metadata
.directory

# Temporary files
*~
*.swp
*.swo
*.bak
*.tmp

# Log files
*.log

# Build artifacts and directories
**/build/
build/
*.o
*.a
*.out
# For any host-side utilities compiled on Windows
*.exe

# ESP-IDF specific build outputs
*.bin
*.elf
*.map
# Generated in the build directory
flasher_args.json
sdkconfig.old
sdkconfig

# ESP-IDF dependencies
# For older versions or manual component management
/components/.idf/
**/components/.idf/
# For modern ESP-IDF component manager
managed_components/
# If ESP-IDF tools are installed/referenced locally to the project
.espressif/

# CMake generated files
CMakeCache.txt
CMakeFiles/
cmake_install.cmake
install_manifest.txt
CTestTestfile.cmake

# Python environment files
*.pyc
*.pyo
*.pyd
__pycache__/
*.egg-info/
dist/

# Virtual environment folders
venv/
.venv/
env/

# Language Servers
.clangd/
.ccls-cache/
compile_commands.json

# Windows specific
Thumbs.db
ehthumbs.db
Desktop.ini

# Per-unit admin keys. Nothing is stored by the tools -- the operator
# supplies a keys file (device_api.secrets.KeyfileSecretStore) each
# session and it stays in RAM. Ignore any such file (and the old
# plaintext JSON) in case one is kept in the tree.
*.keys
admin_keys*.txt
tools/admin_secrets.json

# User-specific configuration files
*.user
# General workspace files, can be from various tools
*.workspace
# Visual Studio Solution User Options
*.suo
# Visual Studio Solution Document States
*.sln.docstates
